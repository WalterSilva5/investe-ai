generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TenantKind {
  PERSONAL
  COMPANY
}

enum AssetType {
  STOCK
  FII
  ETF
  FIXED_INCOME
  CRYPTO
  CASH
}

enum TransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAW
  DIVIDEND
  INTEREST
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  plan      String     @default("free")
  kind      TenantKind @default(PERSONAL)
  cnpj      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  memberships  Membership[]
  portfolios   Portfolio[]
  credentials  ProviderCredential[]
  conversations Conversation[]
  audits       AuditEvent[]
  policies     InvestmentPolicy[]
  goals        Goal[]
  alerts       AlertRule[]
  usages       AiUsage[]
  imports      ImportJob[]
  documents    Document[]
  memories     Memory[]
  insights     Insight[]
  statements   BankStatement[]
  financeBooks FinanceBook[]
  opportunityBriefs OpportunityBrief[]
  cycleSummaries CycleSummary[]
  actionDigests ActionDigest[]
  signalLogs SignalLog[]
  trackedSymbols TrackedSymbol[]
  promptEvalRuns PromptEvalRun[]
  lessonProgress LessonProgress[]
  notifications Notification[]
  businessProfile BusinessProfile?
  businessIdeas BusinessIdea[]
  orderProposals OrderProposal[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String?
  name           String?
  googleId       String?   @unique
  emailVerifiedAt DateTime?
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
  tokens        Token[]
  conversations Conversation[]
  audits        AuditEvent[]
  usages        AiUsage[]
}

model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  role     Role   @default(MEMBER)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProviderCredential {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  providerId   String
  encryptedKey String
  iv           String
  authTag      String
  baseUrl      String?
  model        String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerId])
  @@index([tenantId])
}

model Conversation {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  title      String?
  providerId String?
  model      String?
  summary    String?
  summaryCount Int    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([tenantId, createdAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  citations      Json?
  tokensIn       Int         @default(0)
  tokensOut      Int         @default(0)
  cost           Decimal     @default(0)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ToolCall {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  conversationId String?
  tool           String
  input          Json?
  output         Json?
  durationMs     Int      @default(0)
  status         String   @default("ok")
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([conversationId])
}

model AuditEvent {
  id       String   @id @default(cuid())
  tenantId String
  userId   String?
  action   String
  entity   String?
  entityId String?
  metadata Json?
  ip       String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model Portfolio {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  currency  String   @default("BRL")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts     Account[]
  transactions Transaction[]
  positions    Position[]

  @@index([tenantId])
}

model Account {
  id          String   @id @default(cuid())
  portfolioId String
  name        String
  institution String?
  type        String   @default("BROKER")
  createdAt   DateTime @default(now())

  portfolio    Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([portfolioId])
}

model Asset {
  id       String    @id @default(cuid())
  symbol   String
  name     String
  type     AssetType
  currency String    @default("BRL")
  metadata Json?
  createdAt DateTime @default(now())

  prices       Price[]
  transactions Transaction[]
  positions    Position[]

  @@unique([symbol, type])
  @@index([type])
}

model Transaction {
  id          String          @id @default(cuid())
  portfolioId String
  accountId   String?
  assetId     String
  type        TransactionType
  quantity    Decimal        
  price       Decimal        
  fees        Decimal         @default(0)
  date        DateTime
  notes       String?
  createdAt   DateTime        @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  asset     Asset     @relation(fields: [assetId], references: [id])

  bankTransactions BankTransaction[]

  @@index([portfolioId, date])
  @@index([assetId])
}

model Position {
  id           String   @id @default(cuid())
  portfolioId  String
  assetId      String
  quantity     Decimal  @default(0)
  averagePrice Decimal  @default(0)
  invested     Decimal  @default(0)
  updatedAt    DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id])

  @@unique([portfolioId, assetId])
}

model Price {
  id        String   @id @default(cuid())
  assetId   String
  date      DateTime
  close     Decimal 
  source    String
  fetchedAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, date])
  @@index([assetId, date])
}

model FxRate {
  id     String   @id @default(cuid())
  pair   String
  date   DateTime
  rate   Decimal 
  source String
  fetchedAt DateTime @default(now())

  @@unique([pair, date])
}

model MacroSeries {
  id     String   @id @default(cuid())
  code   String
  date   DateTime
  value  Decimal 
  source String
  fetchedAt DateTime @default(now())

  @@unique([code, date])
  @@index([code, date])
}

model FixedIncomeRate {
  id        String   @id @default(cuid())
  issuer    String
  product   String
  indexer   String
  rate      Decimal 
  maturity  DateTime?
  source    String
  fetchedAt DateTime @default(now())

  @@index([issuer, product])
}

model InvestmentPolicy {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  riskProfile      String?
  horizon          String?
  targetAllocation Json?
  bands            Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Goal {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  targetAmount Decimal
  targetDate   DateTime?
  priority     Int      @default(1)
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Livro de finanças do usuário: 'pessoal' ou 'empresa'. O caixa atual e a
/// reserva são o estado; as entradas são o fluxo (receitas/despesas) usado
/// para calcular excedente mensal e disponível para investir.
model FinanceBook {
  id               String   @id @default(cuid())
  tenantId         String
  kind             String   // 'pessoal' | 'empresa'
  label            String
  cashBalance      Decimal  @default(0)
  emergencyReserve Decimal  @default(0)
  createdAt        DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries FinanceEntry[]

  @@unique([tenantId, kind])
  @@index([tenantId])
}

model FinanceEntry {
  id        String   @id @default(cuid())
  bookId    String
  kind      String   // 'income' | 'expense'
  amount    Decimal
  category  String?
  note      String?
  date      DateTime
  createdAt DateTime @default(now())

  book FinanceBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, date])
}

model AlertRule {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  condition Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events AlertEvent[]

  @@index([tenantId])
}

model AlertEvent {
  id        String   @id @default(cuid())
  ruleId    String
  firedAt   DateTime @default(now())
  payload   Json?

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, firedAt])
}

model AiUsage {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  providerId String
  model     String
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  cost      Decimal  @default(0)
  task      String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model ImportJob {
  id        String   @id @default(cuid())
  tenantId  String
  status    String   @default("PENDING")
  filename  String?
  result    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model Document {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  body      String
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  attachments DocumentAttachment[]

  @@index([tenantId, createdAt])
}

model DocumentAttachment {
  id          String   @id @default(cuid())
  documentId  String
  tenantId    String
  filename    String
  mimeType    String
  size        Int
  storagePath String
  textContent String?
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([tenantId])
}

model Token {
  id         String    @id @default(cuid())
  userId     String
  type       String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Memory {
  id         String   @id @default(cuid())
  tenantId   String
  kind       String   @default("fact")
  content    String
  tags       String?
  importance Int      @default(5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind])
  @@index([tenantId, createdAt])
}

model Insight {
  id          String   @id @default(cuid())
  tenantId    String
  category    String   @default("GERAL")
  title       String
  content     String
  sources     Json?
  providerId  String?
  model       String?
  isRead      Boolean  @default(false)
  generatedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, generatedAt])
}

model BankStatement {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  institution String?
  source      String   @default("OFX")
  periodStart DateTime?
  periodEnd   DateTime?
  importedAt  DateTime @default(now())

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([tenantId, importedAt])
}

model BankTransaction {
  id          String   @id @default(cuid())
  statementId String
  date        DateTime
  description String
  amount      Decimal
  type        String   @default("EXPENSE")
  category    String?
  balance     Decimal?
  raw         String?

  portfolioTransactionId String?
  reconciledAt           DateTime?
  portfolioTransaction   Transaction? @relation(fields: [portfolioTransactionId], references: [id], onDelete: SetNull)

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId, date])
  @@index([portfolioTransactionId])
}

model OpportunityBrief {
  id          String   @id @default(cuid())
  tenantId    String
  theme       String
  title       String
  stage       String   @default("EMERGENTE")
  mode        String   @default("growth")
  attention   Int      @default(0)
  hypeRisk    Int      @default(0)
  content     Json
  sources     Json?
  providerId  String?
  model       String?
  generatedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, theme, generatedAt])
}

model OpportunitySnapshot {
  id         String   @id @default(cuid())
  theme      String
  attention  Int      @default(0)
  hypeRisk   Int      @default(0)
  capturedAt DateTime @default(now())

  @@index([theme, capturedAt])
  @@index([capturedAt])
}

model BusinessProfile {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  headline       String?
  summary        String?
  skills         Json?
  experience     Json?
  education      Json?
  languages      Json?
  certifications Json?
  interests      Json?
  location       String?
  availability   String?
  incomeGoal     Decimal?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BusinessIdea {
  id         String   @id @default(cuid())
  tenantId   String
  kind       String
  title      String
  summary    String
  score      Int      @default(0)
  content    Json
  providerId String?
  model      String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model CycleSummary {
  id            String   @id @default(cuid())
  tenantId      String
  title         String
  summary       String
  dominantStage String   @default("EMERGENTE")
  topThemes     Json?
  risks         Json?
  watchPoints   Json?
  providerId    String?
  model         String?
  generatedAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, generatedAt])
}

model ActionDigest {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  summary     String
  actions     Json?
  providerId  String?
  model       String?
  generatedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, generatedAt])
}

model SignalLog {
  id          String    @id @default(cuid())
  tenantId    String
  symbol      String
  kind        String    @default("outlook")
  rule        String
  direction   String
  score       Int       @default(50)
  price       Float
  target      Float?
  stop        Float?
  day         String
  createdAt   DateTime  @default(now())
  evaluatedAt DateTime?
  outcome     String    @default("pending")
  returnPct   Float?
  priceAfter  Float?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, symbol, rule, day])
  @@index([tenantId, day])
  @@index([tenantId, outcome])
}

model TrackedSymbol {
  id        String   @id @default(cuid())
  tenantId  String
  symbol    String
  source    String   @default("discovered")
  score     Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, symbol])
  @@index([tenantId, score])
}

model AgentPrompt {
  id           String    @id @default(cuid())
  profileId    String
  version      Int
  status       String    @default("candidate")
  systemPrompt String
  notes        String?
  evalScore    Float?
  evalDetails  Json?
  createdAt    DateTime  @default(now())
  activatedAt  DateTime?

  runs PromptEvalRun[]

  @@unique([profileId, version])
  @@index([profileId, status])
}

model OrderProposal {
  id          String    @id @default(cuid())
  tenantId    String
  portfolioId String?
  symbol      String
  side        String // BUY | SELL
  quantity    Float
  price       Float
  score       Int       @default(0)
  rule        String // ex.: contrarian, action-tips, seer
  verdict     String // Oportunidade | Aguardar | Evitar
  reason      String?
  status      String    @default("paper") // paper | executed | rejected
  executedAt  DateTime?
  paperPrice  Float?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
}

model PromptEvalRun {
  id        String   @id @default(cuid())
  promptId  String
  tenantId  String
  score     Float
  results   Json
  createdAt DateTime @default(now())

  prompt AgentPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([promptId, createdAt])
}

/// Backtest de prompts por classe de ativo: um run por (classe, variante).
model PromptSimRun {
  id        String   @id @default(cuid())
  classId   String
  variantId String
  symbols   Json
  anchors   Int
  calls     Int
  hits      Int
  hitRate   Float
  score     Float
  details   Json?
  model     String?
  createdAt DateTime @default(now())

  @@index([classId, createdAt])
  @@index([classId, score])
}

model LessonProgress {
  id         String   @id @default(cuid())
  tenantId   String
  lessonId   String
  attempts   Int      @default(0)
  correct    Boolean  @default(false)
  completedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, lessonId])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  kind      String   @default("hot-opportunity")
  title     String
  body      String
  url       String?
  dedupeKey String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, read, createdAt])
}
