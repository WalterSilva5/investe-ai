NODE_ENV=development
PORT=3000
API_PREFIX=api

DATABASE_URL=file:./dev.db


JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

FRONTEND_URL=http://localhost:4200

# IA
AI_DEFAULT_PROVIDER=opencode
# Visão: modelo usado para descrever imagens quando o modelo principal não enxerga
# (o mesmo provedor configurado no app é reutilizado). Vazio = usa OCR local (tesseract).
AI_VISION_MODEL=claude-haiku-5-5
# Modelos com visão NATIVA (recebem a imagem direto, sem duas etapas), separados por vírgula
AI_VISION_MODELS=
# Chave AES-256-GCM (32 bytes). Gere com: openssl rand -base64 32
# Obrigatória em produção (o app falha ao subir se estiver ausente).
AI_ENCRYPTION_KEY=
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-pro
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
AI_MAX_TOKENS_PER_REQUEST=4096
# 0 = ilimitado. 2.000.000 = folga para uso intenso; o valor existe para travar loop desgovernado.
AI_MONTHLY_TOKEN_QUOTA=2000000

# Cotações
BRAPI_TOKEN=
ENABLE_CRON=true

# Insights de IA (dicas periódicas)
# Feeds RSS separados por vírgula; vazio usa o padrão (InfoMoney, Exame, Agência Brasil, CoinDesk, The Block)
INSIGHT_NEWS_FEEDS=

# E-mail (digest de insights; opcional — se vazio, só notificação in-app)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin e CORS
ADMIN_EMAILS=
CORS_ORIGINS=

# Autenticação do ambiente (padrão: aberto, sem login — uso pessoal local).
# false/ausente = abre direto, sem cadastro (assume app rodando localmente).
# Para deploy aberto com contas, defina AUTH_ENABLED=true.
AUTH_ENABLED=false
# Legado: LOCAL_MODE=true equivale a AUTH_ENABLED=false.
# LOCAL_MODE=true

# Auto-ajuste diário do prompt (L5): candidato → eval → promoção só com margem sobre o baseline.
PROMPT_AUTO_TUNE=true
