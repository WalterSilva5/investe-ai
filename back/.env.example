NODE_ENV=development
PORT=3000
API_PREFIX=api

DATABASE_URL=postgresql://wsi:wsi@localhost:5433/wsi_invest?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

FRONTEND_URL=http://localhost:4200

# IA
AI_DEFAULT_PROVIDER=opencode
AI_ENCRYPTION_KEY=
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-pro
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
AI_MAX_TOKENS_PER_REQUEST=4096
AI_MONTHLY_TOKEN_QUOTA=200000

# Cotações
BRAPI_TOKEN=
ENABLE_CRON=true

# Insights de IA (dicas periódicas)
# Feeds RSS separados por vírgula; vazio usa o padrão (InfoMoney, Exame, Agência Brasil, CoinDesk, The Block)
INSIGHT_NEWS_FEEDS=

# Admin e CORS
ADMIN_EMAILS=
CORS_ORIGINS=
